# Copy to `.env` for local development (`startup::prepare` loads it when DOIDO_ENV=development).
DOIDO_ENV=development
DATABASE_URL=mysql://root:password@localhost:3306/quicknfe_development
RUST_LOG=info
# MCP (Streamable HTTP + OAuth) — enabled by default in development via DOIDO_ENV
MCP_ENABLED=true
MCP_PUBLIC_URL=http://localhost:3000
MCP_OAUTH_SIGNING_SECRET=change-me-to-a-long-random-string
# Opcional: mock local (settings.sefin.base_url, ambiente 2)
# SEFIN_BASE_URL=http://127.0.0.1:8090/API/SefinNacional

# Certificado A1 (mTLS ADN — sync municipal, worker e ./execute.sh adn)
# Opção A (recomendada): PFX em base64 — mesmo formato do upload de certificado na UI.
# ADN_MTLS_PFX_BASE64=
# Opção B: arquivo local (não versionado)
ADN_MTLS_PFX_PATH=./certificado.pfx
ADN_MTLS_PFX_PASSWORD=
# Aliases: CERTIFICADO_PFX_BASE64, CERTIFICADO_PFX_PATH, CERTIFICADO_PFX_PASSWORD
# Gerar base64: base64 -w0 backend/certificado.pfx
